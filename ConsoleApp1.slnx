using System;

class Program
{
    static void Main(string[] args)
    {
        // Q1
        double[] prices = { 25.5, 40.0, 33.75 };
        Console.WriteLine(prices[1]);

        // Q2
        int[,] shelfCopies = new int[2, 2] { { 3, 5 }, { 1, 4 } };
        Console.WriteLine(shelfCopies[1, 0]);

        // Q3
        PrintWelcomeMessage();

        // Q4
        PrintBookTitle("Clean Code");

        // Q5
        int pages = 400;
        AddBonusPages(pages);
        Console.WriteLine(pages);

        // Q6
        double[] prices2 = { 25.5, 40.0 };
        ApplyDiscount(prices2);
        Console.WriteLine(prices2[0]);

        // Q7
        int pages2 = 400;
        AddBonusPagesByRef(ref pages2);
        Console.WriteLine(pages2);

        // Q8
        double[] prices3 = { 25.5, 40.0, 33.75 };
        ReplaceArray(ref prices3);
        Console.WriteLine(prices3.Length);

        // Q9
        double price;
        bool found = TryGetPrice("Clean Code", out price);
        Console.WriteLine(found + " " + price);

        // Q10
        PrintBookInfo("Clean Code");
        PrintBookInfo("Clean Code", 464);

        // Q11
        PrintBookInfo(pages: 500, title: "The Pragmatic Programmer");

        // Q12
        PrintAllTitles("Clean Code", "The Pragmatic Programmer", "Refactoring");
    }

    static void PrintWelcomeMessage() => Console.WriteLine("Welcome to the Library!");

    static void PrintBookTitle(string title) => Console.WriteLine("Book title: " + title);

    static void AddBonusPages(int pages) => pages = pages + 50;

    static void ApplyDiscount(double[] prices) => prices[0] = prices[0] - 5;

    static void AddBonusPagesByRef(ref int pages) => pages = pages + 50;

    static void ReplaceArray(ref double[] prices) =>
        prices = new double[] { 10.0, 12.5, 15.0 };

    static bool TryGetPrice(string title, out double price)
    {
        if (title == "Clean Code") { price = 25.5; return true; }
        price = 0;
        return false;
    }

    static void PrintBookInfo(string title, int pages = 300) =>
        Console.WriteLine("Title: " + title + ", Pages: " + pages);

    static void PrintAllTitles(params string[] titles)
    {
        foreach (string title in titles)
            Console.WriteLine(title);
    }
}
